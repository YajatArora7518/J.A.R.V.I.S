# ==============================================================================
# JARVIS AI — Environment Configuration Template
# Copy this file to .env and populate with your API keys and configuration.
# Never commit your actual .env file or credentials to source control.
# ==============================================================================

# Core AI API Keys
# Gemini API Key (Required for real-time Gemini Live voice & vision)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Optional / Fallback for background LLM intent routing)
# Get key: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection
# Default: gemini-2.0-flash
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
# config/runtime.json selects hybrid mode. Set false here for explicit local-only AI.
JARVIS_CLOUD_AI=true

# Local Ollama Provider (Optional offline AI engine)
# Set to true if running local Ollama instance
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=fotiecodes/jarvis:latest

# Operating System Configuration
# Supported: windows | mac | linux (Default: windows)
OS_SYSTEM=windows

# REST API & SDK Server Configuration
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Web Search API Providers (Optional - falls back to DuckDuckGo automatically)
SERPER_API_KEY=
BRAVE_API_KEY=

# Security & Verification
# RISK_LEVEL_DEFAULT: LOW | MEDIUM | HIGH | CRITICAL
RISK_LEVEL_DEFAULT=LOW
CONFIRMATION_TIMEOUT_SECONDS=30
